<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_input_field"
    android:padding="8dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textOutboxType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COUNT"
            android:textColor="@color/brand_orange"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textOutboxStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[PENDING]"
            android:textColor="@color/warning_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/textOutboxAttempts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Coba: 0"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/textOutboxUuid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UUID: -"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/textOutboxError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Error: -"
        android:textColor="@color/danger_red"
        android:textSize="11sp"
        android:layout_marginTop="2dp"
        android:visibility="gone" />
</LinearLayout>
